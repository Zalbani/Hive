# Code given to the residents (hall notice, AG convocation). Anyone who has it can open the portal.
# Changing it blocks new sign-ins with the old code; existing sessions stay valid.
RESIDENCE_ACCESS_CODE=0324

# Key that signs the session cookie, at least 32 characters (e.g. `openssl rand -hex 32`).
# Changing it signs every resident out.
SESSION_SECRET=change-me-with-a-random-string-of-64-chars-0000000000000000

# Optional: pins "today" (ISO date) so each "À la une" variant can be checked with the fake data.
# Leave empty in production.
DEMO_NOW=
