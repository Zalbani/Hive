---
import type { Tone } from '../domain/tone'

export type HighlightBackground = 'home' | 'works' | 'action' | 'summary'

interface Props {
  background: HighlightBackground
  kicker: string
  kickerTone: Tone
  title: string
  lead: string | null
}

const { background, kicker, kickerTone, title, lead } = Astro.props
const hasActions = Astro.slots.has('actions')
---

<section class:list={['highlight', `highlight--${background}`]} aria-labelledby="highlight-title">
  <div class="h-glow highlight__glow highlight__glow--light" aria-hidden="true"></div>
  <div class="highlight__glow highlight__glow--lilac" aria-hidden="true"></div>
  <div class="highlight__main">
    <div class="highlight__text">
      <span class="highlight__kicker" data-tone={kickerTone}>
        {kicker}
      </span>
      <h1 id="highlight-title" class="highlight__title">
        {title}
      </h1>
      {lead !== null && <p class="highlight__lead">{lead}</p>}
      <slot />
      {hasActions && (
        <div class="highlight__actions">
          <slot name="actions" />
        </div>
      )}
    </div>
    <slot name="aside" />
  </div>
  <slot name="footer" />
</section>

<style>
  .highlight {
    position: relative;
    overflow: hidden;
    padding: clamp(28px, 5vw, 52px);
    border-radius: var(--radius-hero);
  }

  .highlight--home {
    background: var(--gradient-home);
  }

  .highlight--works {
    background: var(--gradient-works);
  }

  .highlight--action {
    background: var(--gradient-action);
  }

  .highlight--summary {
    background: var(--gradient-summary);
  }

  .highlight__glow--light {
    width: 320px;
    height: 320px;
    right: 160px;
    top: -160px;
  }

  .highlight__glow--lilac {
    position: absolute;
    width: 240px;
    height: 240px;
    right: -60px;
    bottom: -120px;
    border-radius: 50%;
    background: var(--lilac-bg);
    opacity: 0.8;
    filter: var(--blur-glow);
    pointer-events: none;
  }

  .highlight__main {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-9);
  }

  .highlight__text {
    flex: 999 1 420px;
  }

  .highlight__kicker {
    display: inline-block;
    margin-bottom: var(--space-5);
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--color-white);
    color: var(--tone-fg);
    font-size: var(--text-xs);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-kicker);
    text-transform: uppercase;
  }

  .highlight__kicker[data-tone='ink'] {
    color: var(--color-ink);
  }

  .highlight__title {
    max-width: 640px;
    font-size: var(--text-hero);
    font-weight: var(--weight-extrabold);
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-tight);
  }

  .highlight__lead {
    max-width: 560px;
    margin-top: var(--space-4-5);
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }

  .highlight__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-7);
  }
</style>
