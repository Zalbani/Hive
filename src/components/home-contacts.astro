---
import type { ResidenceContacts } from '../data/contacts'
import { CouncilRoles } from '../domain/contact'
import { Tones } from '../domain/tone'
import { format, type Translation } from '../i18n/t'
import { Routes, toMailtoHref } from '../utils/routes'
import { toPhoneHref } from '../utils/text'
import SectionHeading from './section-heading.astro'

interface Props {
  contacts: ResidenceContacts
  translation: Translation
}

const { contacts, translation } = Astro.props
const t = translation.home
const pinnedEmergencies = contacts.emergencies.filter(
  (emergency) => emergency.pinnedOnHome && emergency.phone !== null,
)
const president =
  contacts.councilMembers.find((member) => member.role === CouncilRoles.PRESIDENT) ?? null
---

<section class="home-contacts">
  <SectionHeading
    title={t.contactsTitle}
    tone={Tones.SAGE}
    linkHref={Routes.CONTACTS}
    linkLabel={t.contactsLink}
  />
  <ul class="h-list-card home-contacts__list" data-tone={Tones.SAGE}>
    <li class="home-contacts__row">
      <span class="home-contacts__who">
        <span class="home-contacts__name">
          {translation.contacts.syndicBadge} · {contacts.syndic.name}
        </span>
        <span class="home-contacts__detail">{contacts.syndic.shortOpeningHours}</span>
      </span>
      <a href={toPhoneHref(contacts.syndic.phone)} class="home-contacts__phone">
        {contacts.syndic.phone}
      </a>
    </li>
    {pinnedEmergencies.map((emergency) => (
      <li class="home-contacts__row">
        <span class="home-contacts__who">
          <span class="home-contacts__name">{emergency.label}</span>
          <span class="home-contacts__detail">{emergency.contactName}</span>
        </span>
        {emergency.phone !== null && (
          <a href={toPhoneHref(emergency.phone)} class="home-contacts__phone">
            {emergency.phone}
          </a>
        )}
      </li>
    ))}
    {president !== null && (
      <li class="home-contacts__row">
        <span class="home-contacts__who">
          <span class="home-contacts__name">{t.councilLabel}</span>
          <span class="home-contacts__detail">
            {format(t.councilPresident, { name: president.displayName })}
          </span>
        </span>
        <a href={toMailtoHref(president.email, null)} class="h-text-link home-contacts__write">
          {t.write}
        </a>
      </li>
    )}
  </ul>
</section>

<style>
  .home-contacts {
    flex: 1 1 400px;
  }

  .home-contacts__list {
    padding: var(--space-1) var(--space-5);
  }

  .home-contacts__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding: 13px 0;
  }

  .home-contacts__who {
    line-height: 1.3;
  }

  .home-contacts__name {
    display: block;
    font-size: var(--text-md);
    font-weight: var(--weight-bold);
  }

  .home-contacts__detail {
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .home-contacts__phone {
    padding: var(--space-1-5) var(--space-3);
    border-radius: var(--radius-pill);
    background: var(--tone-bg);
    color: var(--tone-fg);
    font-size: var(--text-md);
    font-weight: var(--weight-extrabold);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
    transition: background-color var(--duration-fast) ease;
  }

  .home-contacts__phone:hover {
    color: var(--tone-fg);
    background: var(--tone-dot);
  }

  .home-contacts__write {
    font-size: var(--text-md);
    font-weight: var(--weight-extrabold);
    color: var(--tone-fg);
  }
</style>
