---
import type { Syndic } from '../domain/contact'
import { Tones } from '../domain/tone'
import { format, type Translation } from '../i18n/t'
import { toMailtoHref } from '../utils/routes'
import { toPhoneHref } from '../utils/text'

interface Props {
  syndic: Syndic
  translation: Translation
}

const { syndic, translation } = Astro.props
const t = translation.contacts
const facts = [
  { label: t.phone, value: syndic.phone },
  { label: t.email, value: syndic.email },
  { label: t.hours, value: syndic.openingHours },
]
---

<section class="syndic" data-tone={Tones.SAGE} aria-labelledby="syndic-title">
  <div class="syndic__identity">
    <span class="h-tile h-tile--large" aria-hidden="true">
      {syndic.initials}
    </span>
    <div class="syndic__names">
      <span class="h-badge">{t.syndicBadge}</span>
      <h2 id="syndic-title" class="syndic__name">
        {syndic.name}
      </h2>
      <p class="syndic__manager">{format(t.manager, { name: syndic.managerName })}</p>
    </div>
  </div>
  <dl class="syndic__facts">
    {facts.map((fact) => (
      <div class="syndic__fact">
        <dt class="syndic__fact-label">{fact.label}</dt>
        <dd class="syndic__fact-value">{fact.value}</dd>
      </div>
    ))}
  </dl>
  <div class="syndic__actions">
    <a href={toPhoneHref(syndic.phone)} class="h-btn h-btn--primary">
      {t.call}
    </a>
    <a href={toMailtoHref(syndic.email, null)} class="h-btn h-btn--soft">
      {t.write}
    </a>
  </div>
</section>

<style>
  .syndic {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4-5);
    padding: var(--space-6) var(--space-6-5);
    border-radius: var(--radius-3xl);
    background: var(--color-surface);
  }

  .syndic__identity {
    display: flex;
    align-items: center;
    gap: var(--space-3-5);
  }

  .syndic__names {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .syndic__name {
    margin-top: var(--space-1-5);
    font-size: var(--text-2xl);
    font-weight: var(--weight-extrabold);
  }

  .syndic__manager {
    font-size: var(--text-md);
    color: var(--color-ink-muted);
  }

  .syndic__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: var(--space-2-5);
    margin: 0;
  }

  .syndic__fact {
    padding: var(--space-3) var(--space-3-5);
    border-radius: var(--radius-lg);
    background: var(--color-page);
  }

  .syndic__fact-label {
    font-size: var(--text-xs);
    font-weight: var(--weight-bold);
    color: var(--color-ink-muted);
  }

  .syndic__fact-value {
    margin: 2px 0 0;
    font-size: var(--text-base);
    font-weight: var(--weight-bold);
    overflow-wrap: anywhere;
  }

  .syndic__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2-5);
  }
</style>
