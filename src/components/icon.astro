---
import { ICON_PATHS, type IconName } from '../utils/icons'

interface Props {
  name: IconName
  size: number
}

const { name, size } = Astro.props
---

<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {ICON_PATHS[name].map((path) => (
    <path d={path} />
  ))}
</svg>
