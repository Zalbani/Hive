---
import { TOPIC_STAGE_ORDER, TopicStages, type Topic } from '../domain/topic'
import { TOPIC_STAGE_TONES } from '../domain/presentation'
import { format, type Translation } from '../i18n/t'
import { formatNumericDate } from '../utils/dates'
import FilterButtons from './filter-buttons.astro'
import TopicSteps from './topic-steps.astro'

interface Props {
  topics: Topic[]
  translation: Translation
}

const { topics, translation } = Astro.props
const t = translation.topics
const options = TOPIC_STAGE_ORDER.map((stage) => ({
  value: stage,
  label: t.filters[stage],
  tone: TOPIC_STAGE_TONES[stage],
}))
---

<div class="topic-list" data-filter-root>
  <FilterButtons
    label={t.filtersLabel}
    allLabel={format(t.all, { count: topics.length })}
    options={options}
    dotColor="accent"
  />
  {topics.map((topic) => (
    <article
      id={topic.id}
      class="topic-list__item"
      data-tone={TOPIC_STAGE_TONES[topic.stage]}
      data-filter-item
      data-filter-key={topic.stage}
    >
      <div class="topic-list__meta">
        <span class="h-badge topic-list__badge">{t.badges[topic.stage]}</span>
        <span class="topic-list__area">{topic.area}</span>
        <span class="topic-list__date">
          {format(topic.stage === TopicStages.DONE ? t.closedOn : t.updatedOn, {
            date: formatNumericDate(topic.updatedOn),
          })}
        </span>
      </div>
      <h2 class="topic-list__title">{topic.title}</h2>
      <p class="topic-list__description">{topic.description}</p>
      <TopicSteps topic={topic} translation={translation} />
    </article>
  ))}
  <p class="h-empty" role="status" data-filter-empty hidden>
    {t.empty}
  </p>
</div>

<script>
  import '../scripts/list-filter'
</script>

<style>
  .topic-list {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3-5);
  }

  .topic-list > :first-child {
    margin-bottom: var(--space-1);
  }

  .topic-list__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-5-5);
    border-radius: var(--radius-2xl);
    background: var(--color-surface);
    scroll-margin-top: var(--space-6);
  }

  .topic-list__item:target {
    outline: 2px solid var(--tone-accent);
    outline-offset: 2px;
  }

  .topic-list__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2-5);
  }

  .topic-list__badge {
    padding: var(--space-1-5) var(--space-3);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
  }

  .topic-list__area {
    padding: 5px var(--space-2-5);
    border-radius: var(--radius-pill);
    background: var(--color-chip);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-muted);
  }

  .topic-list__date {
    margin-left: auto;
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
  }

  .topic-list__title {
    font-size: var(--text-xl);
    font-weight: var(--weight-extrabold);
  }

  .topic-list__description {
    font-size: var(--text-md);
    line-height: var(--leading-relaxed);
    color: var(--color-ink-soft);
  }
</style>
