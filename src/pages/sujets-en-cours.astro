---
import PageHero from '../components/page-hero.astro'
import TopicList from '../components/topic-list.astro'
import TopicsAside from '../components/topics-aside.astro'
import { getToday } from '../data/clock'
import { getResidence } from '../data/residence'
import { getTopics } from '../data/topics'
import { TopicStages } from '../domain/topic'
import { format, getTranslation, Locales } from '../i18n/t'
import SiteLayout from '../layouts/site-layout.astro'
import { yearOf } from '../utils/dates'
import { NavSections } from '../utils/routes'

const translation = getTranslation(Locales.FR)
const t = translation.topics
const [residence, topics] = await Promise.all([getResidence(), getTopics()])
const currentYear = yearOf(getToday())
const stats = [
  {
    value: topics.filter((topic) => topic.stage !== TopicStages.DONE).length,
    label: t.statActive,
  },
  { value: topics.filter((topic) => topic.stage === TopicStages.VOTE).length, label: t.statVote },
  {
    value: topics.filter(
      (topic) => topic.stage === TopicStages.DONE && yearOf(topic.updatedOn) === currentYear,
    ).length,
    label: format(t.statDone, { year: currentYear }),
  },
]
---

<SiteLayout pageTitle={t.metaTitle} residence={residence} currentSection={NavSections.TOPICS}>
  <PageHero background={NavSections.TOPICS} title={t.title} lead={t.lead}>
    <dl class="topics-stats" aria-label={t.statsLabel}>
      {stats.map((stat) => (
        <div class="topics-stats__item">
          <dt class="topics-stats__label">{stat.label}</dt>
          <dd class="topics-stats__value h-numeric">{stat.value}</dd>
        </div>
      ))}
    </dl>
  </PageHero>
  <div class="topics-layout">
    <TopicList topics={topics} translation={translation} />
    <TopicsAside residence={residence} translation={translation} />
  </div>
</SiteLayout>

<style>
  .topics-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(110px, 1fr));
    gap: var(--space-2-5);
    margin: 0;
  }

  .topics-stats__item {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: var(--space-4) var(--space-4-5);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
  }

  .topics-stats__value {
    margin: 0;
    font-size: var(--text-stat);
    font-weight: var(--weight-extrabold);
    line-height: var(--leading-snug);
  }

  .topics-stats__label {
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    color: var(--color-ink-muted);
  }

  .topics-layout {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: var(--space-6);
  }

  @media (max-width: 480px) {
    .topics-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
